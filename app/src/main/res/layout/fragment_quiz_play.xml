<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarQuizPlay"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Law Awareness Quiz"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBarQuiz"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:indeterminate="false"
        android:max="10"
        android:progress="1"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceVariant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Question View -->
        <ScrollView
            android:id="@+id/layoutQuestionContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvQuestionCounter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Question 1 of 10" />

                    <TextView
                        android:id="@+id/tvQuizCategoryBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_rounded"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Police Rights" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="0.5dp">

                    <TextView
                        android:id="@+id/tvQuestionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4sp"
                        android:padding="16dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="What is the maximum period police can detain an arrested person before presenting them before a Magistrate?" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Options -->
                <LinearLayout
                    android:id="@+id/layoutOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/optionCard1"
                        layout="@layout/item_quiz_option" />

                    <include
                        android:id="@+id/optionCard2"
                        layout="@layout/item_quiz_option" />

                    <include
                        android:id="@+id/optionCard3"
                        layout="@layout/item_quiz_option" />

                    <include
                        android:id="@+id/optionCard4"
                        layout="@layout/item_quiz_option" />

                </LinearLayout>

                <!-- Feedback Text -->
                <TextView
                    android:id="@+id/tvQuizFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2sp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="invisible"
                    tools:text="Correct! Article 22(2) mandates 24 hours."
                    tools:visibility="visible" />

                <!-- Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextQuestion"
                    style="@style/Widget.Material3.Button.FilledButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    android:enabled="false"
                    android:text="@string/quiz_next"
                    android:textSize="15sp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </ScrollView>

        <!-- Result Screen View -->
        <LinearLayout
            android:id="@+id/layoutQuizResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_ashoka_pillar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Quiz Completed!"
                android:textColor="?attr/colorPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:textColor="?attr/colorOnSurface"
                android:textSize="36sp"
                tools:text="8 / 10" />

            <TextView
                android:id="@+id/tvResultFeedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/quiz_passed"
                android:textColor="?attr/colorTertiary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestartQuiz"
                style="@style/Widget.Material3.Button.FilledButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:text="@string/quiz_restart"
                android:textSize="15sp"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
